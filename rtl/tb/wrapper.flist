#=============================================================================
# wrapper.flist — VCS file list for wrapper-level verification testbenches
#=============================================================================
# Used by wv_compile.sh to compile tb_sfu_wrapper / tb_vector_wrapper /
# tb_mxu_wrapper + axi_sparse_slave.v on sz0001.
#
# Compiled with: +define+COCOTB_SIM=1 +vpi -P sim/regression/pli.tab
#                 -load $(cocotb-config --lib-name-path vpi vcs)
#=============================================================================

